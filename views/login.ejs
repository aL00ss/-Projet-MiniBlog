<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Connexion - Blog SLAM</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <header class="header">
            <div class="header-content">
                <h1>Connexion</h1>
                <p class="subtitle">Identifiez-vous pour accéder au blog</p>
            </div>
        </header>

        <div class="form-container" style="max-width:520px;margin:2rem auto;">
            <% if (error) { %>
                <div class="form-error" style="color:#ffb4b4;margin-bottom:1rem;"><%= error %></div>
            <% } %>

            <form action="/login" method="POST" class="form">
                <div class="form-group">
                    <label class="form-label" for="username">Nom d'utilisateur</label>
                    <input class="form-input" id="username" name="username" required>
                </div>

                <div class="form-group">
                    <label class="form-label" for="password">Mot de passe</label>
                    <input class="form-input" id="password" name="password" type="password" required>
                </div>

                <div class="form-group" style="display:flex;gap:1rem;align-items:center;">
                    <button class="btn btn-primary" type="submit">Se connecter</button>
                    <a class="btn btn-ghost" href="/">Annuler</a>
                </div>
            </form>
        </div>
    </div>
            <div class="form-container" style="max-width:520px;margin:2rem auto;">
            <% if (error) { %>
                <div class="form-error" style="color:#ffb4b4;margin-bottom:1rem;"><%= error %></div>
            <% } %>
            </form>
            
            <!-- Formulaire d'inscription -->
            <hr style="margin:1.5rem 0;border-color:rgba(255,255,255,0.04)" />
            <h3 style="margin-bottom:0.5rem;color:var(--primary)">Créer un compte</h3>
            <form action="/register" method="POST" class="form">
                <div class="form-group">
                    <label class="form-label" for="reg-username">Nom d'utilisateur</label>
                    <input class="form-input" id="reg-username" name="username" required>
                </div>

                <div class="form-group">
                    <label class="form-label" for="reg-password">Mot de passe</label>
                    <input class="form-input" id="reg-password" name="password" type="password" required>
                </div>

                <div class="form-group">
                    <label class="form-label" for="reg-password2">Confirmer le mot de passe</label>
                    <input class="form-input" id="reg-password2" name="password2" type="password" required>
                </div>

                <div class="form-group" style="display:flex;gap:1rem;align-items:center;">
                    <button class="btn btn-primary" type="submit">Créer un compte</button>
                </div>
                </form>
                    </div>
    </div>
</body>
</html>